{
    "github": {
        "silent": true
    },
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/fonts/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
